# Public Solana configuration
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional server-side Devnet authority secret key (64-byte JSON array or base58).
# When omitted, the mint manager derives a deterministic Devnet keypair.
FLUME_DEVNET_SECRET_KEY=
