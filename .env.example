# ============================================================================
# FLUME DUAL-MODE CONFIGURATION (DEVNET vs MAINNET)
# Set DEVNET=true for Devnet addresses, positions, swaps & atomic execution.
# Set DEVNET=false for Mainnet addresses, Vybe DeFi positions & Mainnet tx.
# ============================================================================
DEVNET=true
NEXT_PUBLIC_DEVNET=true

# RPC Endpoints
# Public devnet RPC. A private endpoint is optional; Flume falls back here when the configured host does not respond.
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Vybe Network API Key (https://api.vybenetwork.xyz)
# Used for fetching live user yield-invested protocol positions & token balances
VYBE_API_KEY=your_vybe_api_key_here
VYBE_DATA_API_BASE=https://api.vybenetwork.xyz

# Optional Server-Side Devnet Authority Secret Key (64-byte JSON array or base58)
# If left empty, Flume deterministically derives a persistent Devnet authority keypair
FLUME_DEVNET_SECRET_KEY=